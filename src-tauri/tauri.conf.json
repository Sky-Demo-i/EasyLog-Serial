{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyLog Serial",
  "version": "0.4.1",
  "identifier": "com.easylog.serial",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EasyLog Serial — 串口工作台 · lyg · v0.4.1",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "EasyLogger serial workbench",
    "longDescription": "EasyLog Serial 是 EasyLogger 的配套串口工作台：串口收发、快捷指令、日志解析与过滤。"
  }
}
